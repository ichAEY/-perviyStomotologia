HOST=127.0.0.1
PORT=3000
# Для боевого режима: домен без завершающего слеша.
PUBLIC_ORIGIN=https://clinic.example.ru
# Получатель уведомлений клиники. Значения задаются в окружении сервера.
REQUEST_WEBHOOK_URL=
REQUEST_WEBHOOK_TOKEN=
DATA_DIR=/srv/tanem-dentistry-data
# Срок хранения согласовывается владельцем клиники и отражается в её документах.
REQUEST_RETENTION_DAYS=30
